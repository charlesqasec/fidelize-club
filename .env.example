# Fidelize.club — variáveis de ambiente.
#
# Copie para `.env.local` (nunca commitado — ver .gitignore) e preencha com
# os valores do seu projeto Supabase (Project Settings → API).
#
# Nesta etapa (ETAPA 2), nenhuma página/rota lê estas variáveis ainda — os
# clients em src/lib/supabase/ existem prontos para quando a autenticação
# real for implementada.

# Expostas ao navegador (prefixo NEXT_PUBLIC_ obrigatório no Next.js).
# A chave "anon" é pública por design — a segurança vem do RLS, não do sigilo
# desta chave.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Somente servidor. NUNCA prefixar com NEXT_PUBLIC_, nunca importar de
# código que também roda no navegador, nunca commitar o valor real.
# ETAPA 4.6D: usada por src/lib/supabase/adminClient.ts (convite de membro
# de equipe via Auth Admin API + lookup de e-mail já cadastrado em
# profiles, ignorando RLS deliberadamente).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do app, usada para montar o link de redirecionamento do
# e-mail de convite de equipe (ETAPA 4.6D — .../definir-senha). Sem prefixo
# NEXT_PUBLIC_ obrigatório aqui porque só é lida server-side (Server
# Action), mas o valor em si não é sensível.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
